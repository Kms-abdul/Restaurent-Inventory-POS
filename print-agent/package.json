{
  "name": "restaurant-pos-print-agent",
  "version": "1.0.0",
  "description": "Local Windows print agent for the Restaurant POS Platform. Polls Supabase for pending print jobs and sends them to the local Windows printer.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
